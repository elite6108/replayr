# Client-safe. These are embedded in the desktop UI bundle.
# Never put service-role or R2 secrets here.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
VITE_PUBLIC_APP_URL=http://127.0.0.1:8787

# Server-only. Used by Cloudflare Workers and local Supabase CLI.
# Do NOT add these to the desktop app or any VITE_ variable.

# SUPABASE_SERVICE_ROLE_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=
# PUBLIC_APP_URL=
