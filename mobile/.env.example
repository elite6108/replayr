# Client-safe. Same three values as the website. Never put the service role or R2 keys here.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
EXPO_PUBLIC_APP_URL=https://www.replayr.tv
# Optional store fallbacks for “Open in Replayr” when the app is not installed
EXPO_PUBLIC_IOS_APP_STORE_URL=
EXPO_PUBLIC_ANDROID_PLAY_STORE_URL=
