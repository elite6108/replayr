{
  "expo": {
    "name": "Replayr",
    "slug": "replayr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tv.elite.replay",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tv.elite.replay",
      "usesAppleSignIn": true,
      "entitlements": {
        "aps-environment": "production"
      },
      "associatedDomains": [
        "applinks:replayr.tv",
        "applinks:www.replayr.tv",
        "applinks:replayr.tv",
        "applinks:www.replayr.tv"
      ],
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Replayr saves clips you download to your photo library.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "tv.elite.replay",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0b0c0f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "READ_MEDIA_VIDEO",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "replayr.tv",
              "pathPrefix": "/c"
            },
            {
              "scheme": "https",
              "host": "www.replayr.tv",
              "pathPrefix": "/c"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0b0c0f"
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-sharing",
      "expo-image",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#7fd0ef",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Replayr saves clips you download to your photo library.",
          "savePhotosPermission": "Replayr saves clips you download to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": "https://www.replayr.tv"
      },
      "eas": {
        "projectId": "90989ccf-3954-4736-b4e6-8602e8f7d1a0"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "elite6108"
  }
}
