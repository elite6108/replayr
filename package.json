{
  "name": "project-replay",
  "private": true,
  "version": "0.1.6",
  "description": "Project Replay desktop application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --bundles nsis",
    "installer:stage": "node scripts/stage-windows-installer.mjs",
    "mobile:start": "npm start --prefix mobile",
    "web:dev": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "web:deploy": "node worker/scripts/ensure-web-dist.mjs && npm run build --prefix web && npm run deploy --prefix worker -- --var PUBLIC_APP_URL:https://replayr.tv --keep-vars",
    "worker:dev": "node worker/scripts/ensure-web-dist.mjs && npm run sync-env --prefix worker && npm run dev --prefix worker"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-notification": "^2.3.1",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
